# ---- قاعدة البيانات ----
# دور التطبيق: بيانات المؤسسات عبر RLS. لا تستخدم دور المالك هنا أبدًا (يتجاوز RLS في Neon).
DATABASE_URL=postgres://arso_app:change-me@localhost:5432/arso
# دور المصادقة: جداول الهوية والجلسات فقط، ولا يرى بيانات المؤسسات
AUTH_DATABASE_URL=postgres://arso_auth:change-me@localhost:5432/arso
# دور الترحيلات فقط (مالك الجداول)
MIGRATION_DATABASE_URL=postgres://arso_owner:change-me@localhost:5432/arso

# ---- المصادقة ----
# 32 حرفًا على الأقل: openssl rand -base64 32
BETTER_AUTH_SECRET=
# أصل الواجهة. الـ API يُخدم من نفس الأصل عبر وكيل Next (/api/*)
PUBLIC_WEB_URL=http://localhost:3000
INVITATION_TTL_HOURS=72

# ---- البريد (مطلوب في الإنتاج؛ في التطوير تُطبع الرسائل في الطرفية) ----
RESEND_API_KEY=
EMAIL_FROM=أرسو <no-reply@arso.sa>

# ---- الخادم ----
PORT=4000
NODE_ENV=development
# للواجهة: عنوان الـ API الداخلي الذي يوجّه إليه وكيل Next
API_INTERNAL_URL=http://localhost:4000

# ---- المراقبة ----
SENTRY_DSN=
